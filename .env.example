# Salin menjadi .env lalu isi. JANGAN commit file .env.

# Provider LLM: "gemini" (butuh API key) atau "mock" (tanpa panggilan jaringan).
# Jika kosong: gemini bila GEMINI_API_KEY terisi, selain itu mock.
LLM_PROVIDER=gemini
# API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# Lokasi file SQLite (dibuat otomatis saat startup).
DATABASE_PATH=chatbot.db

# Kunci untuk endpoint admin (POST /knowledge-bases, verifikasi pembayaran).
# Jika kosong, endpoint admin dinonaktifkan (503). Ganti nilai ini.
ADMIN_API_KEY=dev-admin-key-change-me
